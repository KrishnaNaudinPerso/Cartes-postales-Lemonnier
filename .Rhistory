# Build evaluator table from scores_long
eval_tab <- scores_long %>%
dplyr::filter(!is.na(score)) %>%
dplyr::group_by(id, organisation) %>%
dplyr::summarise(n_questions = dplyr::n_distinct(question_num),
n_notes = sum(!is.na(score)), .groups = "drop") %>%
dplyr::arrange(id) %>%
dplyr::mutate(organisation = stringr::str_replace_all(organisation,
stringr::regex("cirad", ignore_case = TRUE),
"CIRAD"))
# ---------------------------------------------------------------
# Options globales
# ---------------------------------------------------------------
knitr::opts_chunk$set(
echo    = isTRUE(params$show_code),
message = FALSE,
warning = FALSE,
fig.retina = 2,
dpi = 180,
fig.align = "center",
out.width = "95%"
)
# Packages requis
req <- c(
"rmarkdown", "readxl", "dplyr", "tidyr", "purrr", "stringr", "stringi",
"janitor", "knitr", "tibble", "ggplot2", "scales", "lme4", "lmerTest",
"emmeans", "multcomp", "kableExtra"
)
missing_pkg <- setdiff(req, rownames(installed.packages()))
if (length(missing_pkg) > 0) {
stop("Packages manquants : ", paste(missing_pkg, collapse = ", "),
"\nInstaller avec : install.packages(c(",
paste0('"', missing_pkg, '"', collapse = ", "), "))")
}
library(readxl); library(dplyr); library(tidyr); library(stringr)
library(stringi); library(janitor); library(knitr); library(tibble)
library(ggplot2); library(scales); library(lme4); library(lmerTest)
library(emmeans); library(multcomp); library(kableExtra)
# Palette cohérente pour les modèles
model_colors <- c(
"mistral-large-latest" = "#E69F00",
"gemini-3-pro-preview" = "#56B4E9",
"gpt-5.1"              = "#009E73"
)
model_labels_short <- c(
"mistral-large-latest" = "Mistral",
"gemini-3-pro-preview" = "Gemini",
"gpt-5.1"              = "GPT-5.1"
)
# ---------------------------------------------------------------
# Chemins
# ---------------------------------------------------------------
data_dir   <- "data"
excel_file <- "Results Export_2026_01_14.xlsx"
excel_path <- file.path(data_dir, excel_file)
if (!file.exists(excel_path)) stop("Fichier Excel introuvable : ", excel_path)
out_dir    <- file.path(data_dir, "processed")
dir.create(out_dir, showWarnings = FALSE, recursive = TRUE)
notes_ord <- scores_long %>%
dplyr::filter(!is.na(score)) %>%
dplyr::mutate(id          = factor(id),
crit        = as.integer(crit),
type        = factor(type, levels = c("LLM","RAG")),
order_rank  = (question_numero - 1)*10 +
ifelse(type == "LLM", 0, 5) + crit,
order_z     = as.numeric(scale(order_rank)))
